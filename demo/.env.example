# Copier en demo/.env et remplir. demo/.env n'est jamais commité (.gitignore).

# Mode API (par défaut) : clés de Claude Haiku (extraction des faits) et de Gemini (embeddings).
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Mode local : LLM et embeddings servis par Ollama, sans clé d'API. Décommenter les deux lignes.
# COMPOSE_PROFILES=local
# MEM0_CONFIG=config.local.json
# Modèle d'extraction, à choisir selon la mémoire disponible.
# OLLAMA_LLM_MODEL=qwen2.5:7b

# Valeurs locales de la démo : des chaînes aléatoires, par exemple openssl rand -hex 24.
POSTGRES_PASSWORD=
MEM0_JWT_SECRET=
MEM0_ADMIN_API_KEY=
KEYCLOAK_ADMIN_PASSWORD=
DEMO_USER_PASSWORD=
DEMO_AGENT_SECRET=

# Ports locaux, si 8080 (passerelle) ou 8081 (Keycloak) sont déjà pris.
# MCP_PORT=8080
# KEYCLOAK_PORT=8081
